---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found"
  description="That page doesn't exist. Browse Jenifer Mazer's party design, custom banners, and hand-painted art instead."
  noindex
>
  <section class="section notfound">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>That page went missing.</h1>
      <p class="lede">
        The link may be old, or the piece may have sold. Either way, there's
        plenty else to see.
      </p>
      <div class="notfound__actions">
        <a href="/#gallery" class="btn btn--primary">See Her Work</a>
        <a href="/" class="btn btn--ghost">Back Home</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound { padding-block: clamp(4rem, 12vw, 9rem); }
  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }
</style>
