---
import Base from '../layouts/Base.astro';
import EventInquiry from '../components/EventInquiry.astro';
import { site } from '../data/site';

/*
 * Standalone version of the lead form.
 *
 * Worth having as its own URL: it's the link that goes in her Instagram bio,
 * on a business card, or at the end of an ad. Sending someone to a page that
 * is only the form converts better than dropping them at the top of the
 * homepage and hoping they scroll.
 */

const where = site.location.city
  ? `${site.location.city}, ${site.location.state}`
  : 'your area';

const title = 'Plan Your Event — Jennifer Mazer';
const description = `Tell Jennifer Mazer about your birthday, baby shower, or wedding. Custom banners, dessert tables, pastries, and full party design in ${where}.`;
---

<Base {title} {description}>
  <section class="section intro">
    <div class="wrap">
      <p class="eyebrow">Parties &amp; Events</p>
      <h1>Let's plan it.</h1>
      <p class="lede">
        Birthdays, baby showers, weddings, holidays. Hand-painted banners,
        dessert tables, custom pastries, and styling that all matches because
        one person designed it. Fill this out and Jen will come back with
        what's possible and what it costs.
      </p>
    </div>
  </section>

  <EventInquiry compact />
</Base>

<style>
  .intro { padding-block: clamp(3rem, 8vw, 5rem) clamp(1rem, 2vw, 2rem); }
</style>
