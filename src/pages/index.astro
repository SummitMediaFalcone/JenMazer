---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import PartyGallery from '../components/PartyGallery.astro';
import PartyQuiz from '../components/PartyQuiz.astro';
import ArtFeature from '../components/ArtFeature.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';
import { services } from '../data/services';

/*
 * Page order is deliberate and follows the money.
 *
 * Parties first: services, then proof (the gallery), then the lead form while
 * they're still looking at the photos. Art sits after the form as a single
 * feature — it's a real part of what she does, but it isn't what pays.
 */

const hasLocation = Boolean(site.location.city && site.location.state);

// LocalBusiness schema — this is what makes the party side eligible for the
// Google map pack. It only fires once a city is set, because a LocalBusiness
// with no address is worse than none at all.
const localBusinessSchema = hasLocation
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'LocalBusiness',
        '@id': `${site.url}/#business`,
        name: site.name,
        description: site.shortDescription,
        url: site.url,
        email: site.email,
        ...(site.phone && { telephone: site.phone }),
        address: {
          '@type': 'PostalAddress',
          addressLocality: site.location.city,
          addressRegion: site.location.state,
          addressCountry: 'US',
        },
        areaServed: site.location.serviceArea.map((area) => ({
          '@type': 'City',
          name: area,
        })),
        founder: { '@id': `${site.url}/#person` },
        hasOfferCatalog: {
          '@type': 'OfferCatalog',
          name: 'Party & Event Services',
          itemListElement: services.map((s) => ({
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: s.title,
              description: s.blurb,
            },
          })),
        },
      },
    ]
  : [];

const title = 'Jenifer Mazer — Party Design, Custom Banners & Hand-Painted Art';
const description =
  'Baby showers, birthdays and holidays designed start to finish — hand-painted banners, custom cookies, cakes and pastries, and full party styling. Plus original paintings by Jen Mazer.';
---

<Base {title} {description} schema={localBusinessSchema}>
  <Hero />
  <Services />
  <PartyGallery />

  {/* Second shot at the lead, right after they've scrolled the photos. */}
  <section id="event-inquiry" class="section section--alt">
    <div class="wrap band">
      <div class="band__copy">
        <p class="eyebrow">Start Here</p>
        <h2>Tell Jen about your party.</h2>
        <p class="lede">
          Four taps — what you're celebrating, how many people, when, and
          roughly what you want to spend. She'll come back with what's possible.
          No obligation on the other side of it.
        </p>
      </div>
      <div class="band__quiz">
        <PartyQuiz />
      </div>
    </div>
  </section>

  <ArtFeature />
  <About />
  <Contact />
</Base>

<style>
  .band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (max-width: 900px) {
    .band { grid-template-columns: 1fr; }
  }
</style>
