---
import Signature from './Signature.astro';
import PartyQuiz from './PartyQuiz.astro';

/*
 * Copy on the left, lead box on the right.
 *
 * The quiz is the primary conversion path on the whole site — it sits above
 * the fold, next to the pitch, and asks for an email only after four taps.
 *
 * A thin strip of real work sits under the copy so the hero isn't all text.
 * Jen's face is in the quiz header, where it does the most good: people are
 * about to hand her their kid's birthday.
 */

const strip = [
  {
    src: '/images/parties/unicorn-rainbow-sugar-cookies-jenifer-mazer.jpg',
    alt: 'Trays of pastel rainbow, cloud and unicorn sugar cookies on a styled party table',
  },
  {
    src: '/images/banners/twinkle-twinkle-little-star-baby-shower-banner-jenifer-mazer.jpg',
    alt: 'Hand-painted twinkle twinkle little star baby shower banner with clouds and gold stars',
  },
  {
    src: '/images/parties/cannoli-cream-puffs-dessert-platter-jenifer-mazer.jpg',
    alt: 'Platter of filled cannoli and powdered-sugar cream puffs',
  },
  {
    src: '/images/parties/flamingo-sugar-cookies-jenifer-mazer.jpg',
    alt: 'Tray of coral pink flamingo-shaped iced sugar cookies',
  },
];
---

<section class="hero">
  <div class="wrap hero__inner">
    <div class="hero__copy">
      <Signature height="4.5rem" color="var(--navy)" class="hero__sig" flourish />

      <h1 class="hero__headline">
        Parties worth <em>remembering</em>, made by hand.
      </h1>

      <p class="lede">
        Baby showers, birthdays, and holidays designed start to finish — the
        hand-painted banner, the dessert table, the cookies and cannoli, and the
        styling that ties it together. One person, one idea, no mismatched
        pieces from four different stores.
      </p>

      <ul class="strip">
        {strip.map((s, i) => (
          <li>
            <img
              src={s.src}
              alt={s.alt}
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </li>
        ))}
      </ul>

      <p class="hero__note">
        She also paints. <a href="#art">Hand-painted originals →</a>
      </p>
    </div>

    <div class="hero__lead">
      <PartyQuiz compact />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2.25rem, 6vw, 4.5rem) clamp(3rem, 8vw, 5.5rem);
    overflow: hidden;
  }

  /* Soft citrus wash behind the hero, echoing her canvases. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(50rem 30rem at 82% 10%, rgba(255, 210, 30, 0.2), transparent 65%),
      radial-gradient(38rem 26rem at 8% 80%, rgba(244, 97, 26, 0.14), transparent 62%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__sig { margin-bottom: 1.4rem; }
  @media (prefers-color-scheme: dark) {
    .hero__sig { color: var(--lemon) !important; }
  }

  .hero__headline { margin-bottom: 1.15rem; }
  .hero__headline em { font-style: italic; color: var(--orange); }

  .strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.55rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    max-width: 30rem;
  }

  .strip li {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 4px;
    background: var(--cream-deep);
    box-shadow: var(--shadow);
  }

  .strip img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .strip li:hover img { transform: scale(1.08); }

  .hero__note {
    margin: 1.35rem 0 0;
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .hero__note a {
    color: var(--orange);
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }
  .hero__note a:hover { text-decoration: underline; }

  .hero__lead { align-self: center; }

  @media (max-width: 940px) {
    .hero__inner { grid-template-columns: 1fr; }
    /* Lead box first on mobile — it's the conversion, the copy can wait. */
    .hero__lead { order: -1; }
    .strip { max-width: none; }
  }
</style>
