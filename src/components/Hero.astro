---
import Signature from './Signature.astro';
import PartyQuiz from './PartyQuiz.astro';

/*
 * Copy on the left, lead box on the right. That's it.
 *
 * The only image up here is Jen, and she sits on the lead box where she does
 * the most work: party clients are handing a person their kid's birthday, so
 * her face belongs next to the thing they're about to fill in. Her work has
 * its own slideshow immediately below the fold — repeating it in the hero only
 * split attention away from the form.
 */
---

<section class="hero">
  <div class="wrap hero__inner">
    <div class="hero__copy">
      <Signature height="4.5rem" color="var(--navy)" class="hero__sig" flourish />

      <h1 class="hero__headline">
        Parties worth <em>remembering</em>, made by hand.
      </h1>

      <p class="lede">
        Baby showers, birthdays, and holidays designed start to finish — the
        hand-painted banner, the dessert table, the cookies and cannoli, and the
        styling that ties it together. One person, one idea, no mismatched
        pieces from four different stores.
      </p>

      {/*
        No images in this column. Jen's portrait carries the lead box on the
        right, and the work has its own slideshow immediately below the fold —
        duplicating it here only split attention away from the one thing that
        matters up top, which is the form.
      */}

      <p class="hero__note">
        She also paints. <a href="#art">Hand-painted originals →</a>
      </p>
    </div>

    <div class="hero__lead">
      <PartyQuiz compact />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2.25rem, 6vw, 4rem) clamp(3rem, 8vw, 5.5rem);
    overflow: hidden;
  }

  /* Citrus wash behind the hero, lifted from her canvases. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(50rem 30rem at 82% 8%, rgba(255, 210, 30, 0.2), transparent 65%),
      radial-gradient(38rem 26rem at 6% 82%, rgba(244, 97, 26, 0.15), transparent 62%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__sig { margin-bottom: 1.35rem; }
  @media (prefers-color-scheme: dark) {
    .hero__sig { color: var(--lemon) !important; }
  }

  .hero__headline { margin-bottom: 1.1rem; }
  .hero__headline em { font-style: italic; color: var(--orange); }

  .hero__note {
    margin: 1.75rem 0 0;
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .hero__note a {
    color: var(--orange);
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }
  .hero__note a:hover { text-decoration: underline; }

  .hero__lead { align-self: center; }

  @media (max-width: 940px) {
    .hero__inner { grid-template-columns: minmax(0, 1fr); }
    /* Lead box first on mobile — it's the conversion; copy can wait. */
    .hero__lead { order: -1; }
  }

</style>
