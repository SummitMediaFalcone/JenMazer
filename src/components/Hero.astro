---
import Signature from './Signature.astro';
import { featuredArtworks } from '../data/artworks';

const hero = featuredArtworks[0];
const secondary = featuredArtworks.slice(1, 3);
---

<section class="hero">
  <div class="wrap hero__inner">
    <div class="hero__copy">
      <Signature height="4.5rem" color="var(--navy)" class="hero__sig" />

      <h1 class="hero__headline">
        Paintings that bring <em>color</em> to a room, and parties nobody forgets.
      </h1>

      <p class="lede">
        Original acrylic paintings and prints, hand-painted custom banners, and
        full party design — baby showers, birthdays, and holidays styled down to
        the pastries. All of it made by hand, one at a time.
      </p>

      <div class="hero__actions">
        <a href="#art" class="btn btn--primary">See the Artwork</a>
        <a href="#event-inquiry" class="btn btn--ghost">Plan an Event</a>
      </div>
    </div>

    <div class="hero__gallery">
      {hero && (
        <figure class="hero__figure hero__figure--main">
          <img
            src={`/images/art/${hero.image}`}
            alt={hero.alt}
            width="900"
            height="1200"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      )}
      {secondary.map((art) => (
        <figure class="hero__figure">
          <img
            src={`/images/art/${art.image}`}
            alt={art.alt}
            width="600"
            height="800"
            loading="eager"
            decoding="async"
          />
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 7vw, 5.5rem) clamp(3rem, 8vw, 6rem);
    overflow: hidden;
  }

  /* A soft citrus wash behind the hero, echoing the canvases without
     competing with them. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(50rem 30rem at 82% 12%, rgba(255, 210, 30, 0.18), transparent 65%),
      radial-gradient(38rem 26rem at 10% 78%, rgba(244, 97, 26, 0.13), transparent 62%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: center;
  }

  .hero__sig {
    margin-bottom: 1.5rem;
  }
  @media (prefers-color-scheme: dark) {
    .hero__sig { color: var(--lemon) !important; }
  }

  .hero__headline {
    margin-bottom: 1.25rem;
  }

  .hero__headline em {
    font-style: italic;
    color: var(--orange);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .hero__gallery {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    grid-template-rows: auto auto;
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
  }

  .hero__figure {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--cream-deep);
    box-shadow: var(--shadow);
  }

  .hero__figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__figure--main {
    grid-row: span 2;
    aspect-ratio: 3 / 4;
  }

  .hero__gallery .hero__figure:not(.hero__figure--main) {
    aspect-ratio: 1 / 1;
  }

  @media (max-width: 900px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__gallery { grid-template-columns: 1.35fr 1fr; }
  }

  @media (max-width: 520px) {
    .hero__gallery { grid-template-columns: 1fr 1fr; }
    .hero__figure--main { grid-column: span 2; grid-row: auto; aspect-ratio: 4 / 3; }
  }
</style>
