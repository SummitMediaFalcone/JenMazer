---
import { site } from '../data/site';

/*
 * The form posts to Formspree — no backend, no server, works on a static host.
 *
 * TODO before launch: create a free Formspree account and paste the endpoint
 * below. Netlify Forms is an equally good option if we deploy there; it needs
 * only a `netlify` attribute on the form and no third party at all.
 *
 * Until an endpoint is set, the form renders as a mailto link instead of
 * silently swallowing submissions — a form that looks like it works but
 * throws inquiries away is worse than no form.
 */
const FORMSPREE_ENDPOINT = ''; // TODO e.g. 'https://formspree.io/f/xxxxxxxx'
---

<section id="contact" class="section section--alt">
  <div class="wrap contact">
    <div class="contact__copy">
      <p class="eyebrow">Get in Touch</p>
      <h2>Just have a quick question?</h2>
      <p>
        Planning something? The <a href="/party-inquiry">event form</a> is
        faster — it asks everything Jen needs so she can answer properly the
        first time. For anything else, this reaches her directly. She reads
        every message herself and usually replies within a day or two.
      </p>

      <ul class="contact__direct">
        <li>
          <span>Email</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        {site.phone && (
          <li>
            <span>Phone</span>
            <a href={`tel:${site.phone.replace(/[^\d+]/g, '')}`}>{site.phone}</a>
          </li>
        )}
        {site.social.instagram && (
          <li>
            <span>Instagram</span>
            <a href={site.social.instagram} target="_blank" rel="noopener">
              Follow along
            </a>
          </li>
        )}
      </ul>
    </div>

    {FORMSPREE_ENDPOINT ? (
      <form class="contact__form" action={FORMSPREE_ENDPOINT} method="POST">
        <div class="field">
          <label for="name">Your name</label>
          <input type="text" id="name" name="name" required autocomplete="name" />
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required autocomplete="email" />
        </div>

        <div class="field">
          <label for="topic">What's this about?</label>
          <select id="topic" name="topic">
            <option>Party design &amp; planning</option>
            <option>Baby shower or gender reveal</option>
            <option>Custom banner</option>
            <option>Pastries &amp; party goods</option>
            <option>Buying a painting</option>
            <option>Commissioning original art</option>
            <option>Something else</option>
          </select>
        </div>

        <div class="field">
          <label for="message">Tell her about it</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>

        {/* Honeypot — bots fill it, humans never see it. */}
        <input type="text" name="_gotcha" class="visually-hidden" tabindex="-1" aria-hidden="true" />

        <button type="submit" class="btn btn--primary">Send Message</button>
      </form>
    ) : (
      <div class="contact__form contact__form--placeholder">
        <p class="contact__notice">
          <strong>Form not connected yet.</strong> Add a Formspree or Netlify
          Forms endpoint in <code>src/components/Contact.astro</code> before
          launch. Until then, use the email link so nothing gets lost.
        </p>
        <a href={`mailto:${site.email}`} class="btn btn--primary">
          Email Jen
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: start;
  }

  .contact__direct {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .contact__direct li {
    display: grid;
    gap: 0.15rem;
  }

  .contact__direct span {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .contact__direct a {
    font-size: var(--step-0);
    text-decoration: none;
    color: var(--orange);
  }
  .contact__direct a:hover { text-decoration: underline; }

  .contact__form {
    display: grid;
    gap: 1.15rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .field { display: grid; gap: 0.4rem; }

  .field label {
    font-size: var(--step--1);
    font-weight: 600;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.7rem 0.85rem;
    font-family: inherit;
    font-size: var(--step-0);
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .field textarea { resize: vertical; }

  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--orange);
  }

  .contact__notice {
    padding: 1rem;
    background: rgba(255, 210, 30, 0.16);
    border-left: 3px solid var(--lemon-deep);
    border-radius: 2px;
    font-size: var(--step--1);
  }

  .contact__form--placeholder { align-content: start; justify-items: start; }

  @media (max-width: 860px) {
    .contact { grid-template-columns: minmax(0, 1fr); }
  }
</style>
