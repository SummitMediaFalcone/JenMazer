---
import Signature from './Signature.astro';
import { site } from '../data/site';

const year = 2026; // Build-time constant; bump at each yearly redeploy.
const socials = Object.entries(site.social).filter(([, url]) => Boolean(url));
const hasLocation = Boolean(site.location.city && site.location.state);
---

<footer class="footer section--navy">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <Signature height="3rem" color="var(--lemon)" />
      <p class="footer__tagline">{site.tagline}</p>
      {hasLocation && (
        <p class="footer__loc">
          {site.location.city}, {site.location.state}
          {site.location.serviceArea.length > 0 && (
            <> · Serving {site.location.serviceArea.join(', ')}</>
          )}
        </p>
      )}
    </div>

    <nav class="footer__links" aria-label="Footer">
      <div>
        <h2>Explore</h2>
        <ul>
          <li><a href="/#parties">Parties &amp; Events</a></li>
          <li><a href="/#gallery">Past Work</a></li>
          <li><a href="/party-inquiry">Plan Your Party</a></li>
          <li><a href="/#art">Hand-Painted Art</a></li>
          <li><a href="/#about">About Jen</a></li>
        </ul>
      </div>
      <div>
        <h2>Get in touch</h2>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          {site.phone && <li><a href={`tel:${site.phone.replace(/[^\d+]/g, '')}`}>{site.phone}</a></li>}
          <li><a href="/party-inquiry">Tell her about your event</a></li>
        </ul>
      </div>
      {socials.length > 0 && (
        <div>
          <h2>Follow</h2>
          <ul>
            {socials.map(([name, url]) => (
              <li>
                <a href={url} rel="me noopener" target="_blank">
                  {name.charAt(0).toUpperCase() + name.slice(1)}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </nav>
  </div>

  <div class="wrap footer__base">
    <p>&copy; {year} {site.name}. All artwork and designs are her own.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--navy);
    color: var(--blossom);
    padding-block: clamp(3rem, 7vw, 5rem) 2rem;
  }

  .footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  .footer__tagline {
    margin: 1rem 0 0.4rem;
    color: #b8bce0;
    font-size: var(--step--1);
    letter-spacing: 0.04em;
  }

  .footer__loc {
    margin: 0;
    color: #b8bce0;
    font-size: var(--step--1);
  }

  .footer__links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 2rem;
  }

  .footer__links h2 {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lemon);
    margin-bottom: 0.9rem;
  }

  .footer__links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .footer__links a {
    color: #d8dbf0;
    text-decoration: none;
    font-size: var(--step--1);
    transition: color 0.18s ease;
  }
  .footer__links a:hover { color: var(--lemon); }

  .footer__base {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid rgba(253, 250, 243, 0.16);
  }

  .footer__base p {
    margin: 0;
    color: #9195bd;
    font-size: var(--step--1);
  }

  @media (max-width: 760px) {
    .footer__inner { grid-template-columns: minmax(0, 1fr); }
  }
</style>
