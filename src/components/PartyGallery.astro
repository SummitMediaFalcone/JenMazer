---
import Slideshow from './Slideshow.astro';
import { gallery } from '../data/services';

/*
 * The portfolio wall, as a slideshow.
 *
 * It was a 21-image masonry grid. It looked good but ran several screens tall,
 * which pushed the lead form far down the page. A slideshow shows the same work
 * in roughly one screen, so the form stays within reach.
 */

const slides = gallery.map((g) => ({
  src: `/images/${g.dir}/${g.image}`,
  alt: g.alt,
  caption: g.caption,
  category: g.category,
}));
---

<section id="gallery" class="section">
  <div class="wrap">
    <div class="head">
      <div>
        <p class="eyebrow">Past Work</p>
        <h2>Some of what she's made.</h2>
      </div>
      <p class="lede">
        Every one of these was designed for a specific family and a specific
        day. Nothing here is a stock order.
      </p>
    </div>

    <Slideshow slides={slides} variant="gallery" label="Past work by Jen Mazer" />
  </div>
</section>

<style>
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1rem, 4vw, 3rem);
    align-items: end;
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
  }

  .head h2 { margin-bottom: 0; }
  .head .lede { margin-bottom: 0; font-size: var(--step-0); }

  @media (max-width: 760px) {
    .head { grid-template-columns: 1fr; align-items: start; }
  }
</style>
