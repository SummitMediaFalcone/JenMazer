---
import { site } from '../data/site';

/*
 * THE LOGO — her wordmark.
 *
 * Signed off as-is. Her name set in a script face and styled to sit like a
 * signature: slight tilt, tightened letterfit, and an optional hand-drawn
 * underline. Renders as live text, so it stays crisp at any size, recolours
 * with the theme, and costs nothing to load.
 *
 * If she ever wants her actual handwriting instead, it's a one-file swap —
 * photograph a signature on white paper, trace it, and paste the path into
 * the block marked REAL SIGNATURE below. Every usage (header, footer, hero,
 * emails, favicon) points here, so nothing else changes.
 */

interface Props {
  /** Rendered height in CSS units. */
  height?: string;
  color?: string;
  class?: string;
  /** Set false when visible text next to it already says the name. */
  labelled?: boolean;
  /** The hand-drawn underline. Off for small marks like the header. */
  flourish?: boolean;
}

const {
  height = '2.75rem',
  color = 'currentColor',
  class: className = '',
  labelled = true,
  flourish = false,
} = Astro.props;
---

<span
  class:list={['signature', flourish && 'signature--flourish', className]}
  style={`--sig-height:${height};--sig-color:${color};`}
  role={labelled ? 'img' : undefined}
  aria-label={labelled ? site.name : undefined}
  aria-hidden={labelled ? undefined : 'true'}
>
  {/*
    REAL SIGNATURE — when the traced SVG arrives, delete the <span> below and
    uncomment this, pasting the path data in:

    <svg viewBox="0 0 600 160" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
      <path d="…" stroke="var(--sig-color)" stroke-width="5"
            stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  */}
  <span class="signature__text" aria-hidden="true">{site.name}</span>

  {flourish && (
    <svg class="signature__rule" viewBox="0 0 300 12" preserveAspectRatio="none" aria-hidden="true">
      {/* Deliberately uneven — a ruler-straight line reads as a border, not a pen stroke. */}
      <path
        d="M2 8C40 3 78 9 118 6s72-5 108-1 60 5 70 2"
        fill="none"
        stroke="var(--sig-color)"
        stroke-width="2"
        stroke-linecap="round"
      />
    </svg>
  )}
</span>

<style>
  .signature {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    color: var(--sig-color);
    line-height: 1;
  }

  .signature svg:not(.signature__rule) {
    height: var(--sig-height);
    width: auto;
  }

  /* The placeholder wordmark, styled to sit like a signature rather than like
     a heading set in a script font. Sized so its cap-height roughly matches
     what a traced signature would occupy, which keeps the header from shifting
     when the real one drops in. */
  .signature__text {
    font-family: var(--font-script);
    /* nowrap means this can't reflow, so on a narrow screen the full name
       overhangs the column and gets clipped by the hero's overflow:hidden.
       The vw cap keeps it inside the gutter on phones and never fires on
       desktop, where the calc() value is always the smaller of the two. */
    font-size: min(calc(var(--sig-height) * 1.6), 14vw);
    line-height: 0.76;
    white-space: nowrap;
    letter-spacing: -0.005em;
    /* Italianno sits high in its em box; nudge it onto the baseline. */
    transform: translateY(0.05em) rotate(-1.6deg);
    transform-origin: left center;
  }

  .signature__rule {
    width: min(calc(var(--sig-height) * 4.6), 40vw);
    height: calc(var(--sig-height) * 0.2);
    margin-top: calc(var(--sig-height) * 0.06);
    margin-left: calc(var(--sig-height) * 0.14);
    opacity: 0.55;
    transform: rotate(-1.6deg);
    transform-origin: left center;
    overflow: visible;
  }
</style>
